{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.{js,ts}": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
    }
  },
  "regions": ["iad1"],
  "installCommand": "npm install --legacy-peer-deps"
}