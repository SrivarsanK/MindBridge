# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# Convex Backend
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# JWT Authentication (Generate using OpenSSL - see SECURITY_GUIDE.md)
# These should be set in Convex environment variables, not in .env
# JWT_PRIVATE_KEY=your-private-key-here
# JWKS=your-jwks-json-here

# Razorpay Payment Integration
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Razorpay Webhook Secret
# Get this from https://dashboard.razorpay.com/app/webhooks after creating webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# External APIs (Add as needed)
# OPENAI_API_KEY=sk-...
# ANALYTICS_ID=UA-...
# SENTRY_DSN=https://...

# Google Gemini AI API Key
# Get this from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Development Settings

# Development Settings
NODE_ENV=development

# Optional: Custom Port
# PORT=3000
